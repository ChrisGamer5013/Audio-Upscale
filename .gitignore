# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment (recreated by setup_env.bat)
.venv/
venv/

# Local ffmpeg binaries (auto-downloaded by scripts/install_ffmpeg.py)
tools/ffmpeg/

# Build artifacts
build/
dist/
*.spec.bak

# Models directory: keep local models local - only our own trained
# starter model (and README.md) are tracked in git.
models/*
!models/starter_bwe_48k.onnx
!models/README.md
demo_*.wav
demo_*.flac
demo_*.png
*.compare.png

# OS junk
Thumbs.db
Desktop.ini

# User's test media (never commit someone else's audio/video!)
audio/
video/
